@online{inbo_guarding_nodate,
	title = {Guarding European Waters from {IAS} ({GuardIAS}) ({EVINBO})},
	url = {https://www.vlaanderen.be/inbo/projecten/guarding-european-waters-from-ias-guardias-evinbo},
	abstract = {{GuardIAS} bouwt voort op de goede praktijken in de wereldwijde bioveiligheid en combineert geavanceerde wetenschap, innovatieve technieken en informatiesystemen binnen een transdisciplinair kader om effectieve, technologisch haalbare en maatschappelijk aanvaardbare oplossingen te bieden. Via kunstmatige intelligentie ({AI}) en nieuwe data workflows zullen we verschillende biodiversiteitsdatabanken systematisch bevragen naar soortverspreiding, milieutoleranties, biologische kenmerken en genetische informatie. Dit moet het European Alien Species Information Network ({EASIN}) verbeteren en datasets harmoniseren. Dit zal de inschatting van de impact van invasieve uitheemse soorten ({IAS}) verbeteren voor een meer effectieve preventie en beter beheer van invasies. 

Het toonaangevende burgerwetenschapsplatform {iNaturalist} (dat {AI} gebruikt om soorten te identificeren via smartphonefoto's) wordt uitgebreid met door experts geverifieerde afbeeldingen van aquatische {IAS} om vroege detectie aan de grenzen te ondersteunen en de geografische verspreiding van {IAS} te volgen.

{GuardIAS} zal de dataverzameling, de monitoring, de vroege detectie en het {IAS}-bewustzijn vergroten door innovatieve burgerwetenschapsinitiatieven, waaronder {BioArtBlitz}-evenementen. Dit is een nieuw type evenement waarbij kunst wordt gebruikt als middel voor communicatie en betrokkenheid. We zetten ook in op {eDNA}-bemonstering, geluidsanalyse in een Zooniverse-project en marina-evenementen voor bootbezitters. We betrekken belanghebbenden (beleidsmakers, industrie, wetenschappers, waterbeheerders en controleurs, het publiek, jongeren en onderwijsinstellingen) via innovatieve tools, zoals toegepaste games. 
{GuardIAS} zal samen met milieu-autoriteiten, de industrie en waterbeheerders verscheidene uitroeiings- en beheersingsplannen ontwerpen en implementeren in zowel de mariene als zoetwateromgevingen. 

Door sociale wetenschappen en humane wetenschappen te betrekken, zal {GuardIAS} gezamenlijke kenniscreatie bevorderen, het begrip over het belang van {IAS}-beheer verbeteren en de verspreiding van de projectresultaten ondersteunen. Met name in mariene omgevingen streeft het project ernaar de misvatting te ontkrachten dat het beheer van {IAS} na vestiging zinloos is, en tastbare oplossingen aan te reiken.},
	titleaddon = {{INBO}},
	author = {{INBO}},
	urldate = {2024-09-10},
	file = {Snapshot:C\:\\Users\\janne_adolf\\Zotero\\storage\\M3XF2ABB\\guarding-european-waters-from-ias-guardias-evinbo.html:text/html},
}

@online{inbo_flatwormwatch_nodate,
	title = {{FlatwormWatch}: monitoring van invasieve platwormen met burgerwetenschap},
	url = {https://www.vlaanderen.be/inbo/projecten/flatwormwatch-monitoring-van-invasieve-platwormen-met-burgerwetenschap},
	shorttitle = {{FlatwormWatch}},
	abstract = {Dit burgerwetenschappelijk project is een samenwerking tussen het Nationaal Wetenschappelijk Secretariaat Invasieve Soorten, {UHasselt}, {UAntwerpen}, Plantentuin Meise en {INBO}. 
De hoofddoelen van dit project zijn: het verhogen van de detectiekans van platwormen, het verspreiden van informatie over hun identificatie en impact, en meer informatie verkrijgen over de problematiek van niet-inheemse platwormen in België. We verzamelen informatie over het aantal soorten, de identiteit van de soorten, hun verspreiding, hun introductieroutes en hoe algemeen ze zijn. Dit project zal ook helpen bij het evalueren van het potentieel om burgers te betrekken bij het monitoren van een cryptisch, relatief onbekend taxon. 
Het project streeft ook bijkomende resultaten na, zowel wetenschappelijk als educatief:
- Beoordelen of sommige gebieden in België meer risico lopen op introductie dan andere.
- Inzichten verwerven in de introductieroutes en het gedrag van uitheemse soorten landplanaria.
- Bijdragen tot de opbouw van een genetische databank en identificatie op het niveau van soorten en lijnen mogelijk maken.
- Sensibiliseren voor invasieve uitheemse soorten ({IAS}), de risico's van introductie en verspreiding, hun impact, en meer specifiek voor uitheemse terrestrische planaria, en het belang van de {EU}-verordening, detectie, rapportering en snelle respons.},
	author = {{INBO}},
	urldate = {2024-09-10},
	file = {Snapshot:C\:\\Users\\janne_adolf\\Zotero\\storage\\E8X5UIHV\\flatwormwatch-monitoring-van-invasieve-platwormen-met-burgerwetenschap.html:text/html},
}

