@report{petersen_zeldzaam_2024,
	title = {Zeldzaam maar zorgwekkend: een kartering van vijf prioritaire plantensoorten van de Unielijst: terreinwerk in kader van het {RadIUS}-project},
	shorttitle = {Zeldzaam maar zorgwekkend},
	abstract = {Als onderdeel van het {RadIUS}-project werd terreinwerk verricht om het actueel voorkomen van vijf Unielijstsoorten beter te begrijpen: Aziatische boomwurger, gewone gunnera, moerasaronskelk, struikaster en zijdeplant. We bezochten bekende locaties van deze soorten, bevestigden de aan- of afwezigheid, en brachten de lokale verspreiding in kaart. Waar mogelijk werd bij terreinbeheerders getoetst naar kennis en ervaring, en werd een plan van aanpak op terrein besproken. Deze kartering moet het beleid en het beheer beter in staat stellen om een soortgerichte aanpak voor elk van deze vroeg-invasieve soorten in Vlaanderen te voorzien.},
